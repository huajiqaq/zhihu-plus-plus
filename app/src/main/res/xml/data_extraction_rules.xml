<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 网络诊断目录不随云备份或设备传输外传。 -->
    <cloud-backup>
        <exclude domain="file" path="network-diagnostics/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="network-diagnostics/"/>
    </device-transfer>
</data-extraction-rules>
