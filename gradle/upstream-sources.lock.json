          "base": "21a0c10a228d14545054f9af3a4cfa225e31bb9f",
          "sha256": "8a31f7bd243eacb533534f47cba374a08231298b3592a8ae73d181c608ca9dda",
          "reason": "https://github.com/tiqian-cjk/tiqian-markdown/pull/7 的搜索、选区键、图片预算、末端标记和递归默认导航；划线点击走官方 custom.onClick，所选上游覆盖能力且相关回归通过后移除"
        },
        "upstream-patches/tiqian-markdown-visible-block-layers.patch": {
          "base": "21a0c10a228d14545054f9af3a4cfa225e31bb9f",
          "sha256": "2468e4fb73accabcfb11f9474e79e4461c849f0eaae4323f6ea003b014cb31f0",
