        },
        "upstream-patches/tiqian-markdown-skiko-alignment.patch": {
          "base": "21a0c10a228d14545054f9af3a4cfa225e31bb9f",
          "sha256": "7935c0368161a3632d839552e3b45d475fc51a31e61f0322b16a80be68232486",
          "reason": "同 tiqian-core-skiko-alignment 的 JVM 类路径对齐；数学宿主文字的 FontStyle 构造与字重读取改用两代 Skiko 通用写法。所选上游自身使用同代 Skiko 后移除"
        }
      },
