+            "0..12" to "0..13",
+            "0.17.0" to "0.17.1",
+        ).forEach { (from, to) ->
+            assertFailsWith<AssertionError> { assertStructuralGeometryEquals(expected, expected.replace(from, to)) }
+        }
+    }
