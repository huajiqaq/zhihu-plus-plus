+internal class CffGlyphOutlines(private val typeface: Typeface, private val unitsPerEm: Int) : AutoCloseable {
+    private var decoder: Decoder? = null
+    private var loaded = false
+    private val glyphs = object : LinkedHashMap<UShort, Glyph?>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<UShort, Glyph?>?): Boolean =
+            size > MAX_OUTLINE_CACHE_ENTRIES
+    }
+
+    /** Null means fall back to Skia. A decoded glyph may legitimately have no ink. */
+    @Synchronized
+    fun glyph(glyphId: UShort): Glyph? {
+        if (!loaded) {
+            loaded = true
+            decoder = decodeOrNull { loadDecoder() }
+        }
+        val source = decoder ?: return null
+        if (glyphs.containsKey(glyphId)) return glyphs[glyphId]
+        return decodeOrNull { source.glyph(glyphId.toInt()) }.also { glyphs[glyphId] = it }
+    }
+
+    private fun loadDecoder(): Decoder? {
+        val bytes = typeface.getTableData("CFF ")?.use { it.bytes } ?: return null
+        // CFF2, CID FD-specific matrices, and transformed charstrings stay with the Skia scaler.
+        val font = CFFParser().parse(bytes) { bytes }.singleOrNull() as? CFFType1Font ?: return null
+        val unit = 1.0 / unitsPerEm
+        val identityInDesignUnits = listOf(unit, 0.0, 0.0, unit, 0.0, 0.0)
+        if (font.numCharStrings != typeface.glyphsCount || unitsPerEm != typeface.unitsPerEm ||
+            font.fontMatrix.map { it.toDouble() } != identityInDesignUnits
+        ) return null
+        return Decoder(font)
+    }
+
+    @Synchronized
+    override fun close() {
+        loaded = true
+        decoder = null
+        glyphs.clear()
+    }
+
+    internal class Glyph(private val contours: GeneralPath) {
+        private val designBounds = contours.toSkiaPath(1.0).use { if (it.isEmpty) null else it.computeTightBounds() }
+
+        fun bounds(scale: Double): Rect? = designBounds?.let {
+            Rect.makeLTRB(
+                (it.left * scale).toFloat(), (it.top * scale).toFloat(),
+                (it.right * scale).toFloat(), (it.bottom * scale).toFloat(),
+            )
+        }
+
+        fun path(scale: Double): Path? = if (designBounds == null) null else contours.toSkiaPath(scale)
+    }
+
+    private class Decoder(private val font: CFFType1Font) {
+        private val parser = Type2CharStringParser(font.name)
+        private val charStrings = font.charStringBytes
+        private val globalSubrs = font.globalSubrIndex.toTypedArray()
+        @Suppress("UNCHECKED_CAST")
+        private val localSubrs = font.privateDict["Subrs"] as? Array<ByteArray>
+
+        fun glyph(gid: Int): Glyph? {
+            val bytes = charStrings.getOrNull(gid) ?: return null
+            val name = font.charset.getNameForGID(gid)
+            val sequence = parser.parse(bytes, globalSubrs, localSubrs, name)
+            val program = ArrayList<Any>(sequence.size)
+            var argsStart = 0
+            for (token in sequence) {
+                if (token is Int) {
+                    program.add(token)
+                    continue
+                }
+                when ((token as? CharStringCommand)?.type2KeyWord) {
+                    Type2KeyWord.HFLEX1 -> {
+                        if (program.size - argsStart != 9) return null
+                        // FontBox 3.0.8 drops the final dy of hflex1 (Adobe Type 2 spec, section 4.4).
+                        val dy6 = -(program[argsStart + 1] as Int) - (program[argsStart + 3] as Int) - (program[argsStart + 7] as Int)
+                        program.add(argsStart + 5, 0)
+                        program.add(argsStart + 7, 0)
+                        program.add(dy6)
+                        program.add(CharStringCommand.COMMAND_RRCURVETO)
+                    }
+                    Type2KeyWord.ENDCHAR -> {
+                        if (program.size - argsStart > 1) return null // Deprecated seac composite.
+                        program.add(token)
+                    }
+                    Type2KeyWord.HSTEM, Type2KeyWord.VSTEM, Type2KeyWord.HSTEMHM, Type2KeyWord.VSTEMHM,
+                    Type2KeyWord.HINTMASK, Type2KeyWord.CNTRMASK, Type2KeyWord.RMOVETO, Type2KeyWord.HMOVETO,
+                    Type2KeyWord.VMOVETO, Type2KeyWord.RLINETO, Type2KeyWord.HLINETO, Type2KeyWord.VLINETO,
+                    Type2KeyWord.RRCURVETO, Type2KeyWord.RCURVELINE, Type2KeyWord.RLINECURVE, Type2KeyWord.VVCURVETO,
+                    Type2KeyWord.HHCURVETO, Type2KeyWord.VHCURVETO, Type2KeyWord.HVCURVETO,
+                    Type2KeyWord.FLEX, Type2KeyWord.FLEX1, Type2KeyWord.HFLEX -> program.add(token)
+                    // FontBox rounds fixed16.16 operands and doesn't implement Type 2 stack arithmetic.
+                    else -> return null
+                }
+                argsStart = program.size
+            }
+            if ((program.lastOrNull() as? CharStringCommand)?.type2KeyWord != Type2KeyWord.ENDCHAR) return null
+            val defaultWidth = (font.privateDict["defaultWidthX"] as? Number)?.toInt() ?: 1000
+            val nominalWidth = (font.privateDict["nominalWidthX"] as? Number)?.toInt() ?: 0
+            // Use the size-independent JVM outline cache above, not FontBox's unbounded charstring cache.
+            return Glyph(Type2CharString(font::getType1CharString, font.name, name, gid, program, defaultWidth, nominalWidth).path)
+        }
+    }
+
+    private inline fun <T> decodeOrNull(decode: () -> T?): T? = try {
+        decode()
+    } catch (_: IOException) {
+        null
+    } catch (_: RuntimeException) {
+        // Skia may still support a custom face that FontBox cannot decode.
+        null
+    } catch (_: StackOverflowError) {
+        // FontBox recursively expands subroutines in malformed custom programs.
+        null
+    }
+}
+
+private fun GeneralPath.toSkiaPath(scale: Double): Path = PathBuilder().use { path ->
+    val iterator = getPathIterator(AffineTransform.getScaleInstance(scale, -scale))
+    val p = FloatArray(6)
+    while (!iterator.isDone) {
+        when (iterator.currentSegment(p)) {
+            PathIterator.SEG_MOVETO -> path.moveTo(p[0], p[1])
+            PathIterator.SEG_LINETO -> path.lineTo(p[0], p[1])
+            PathIterator.SEG_QUADTO -> path.quadTo(p[0], p[1], p[2], p[3])
+            PathIterator.SEG_CUBICTO -> path.cubicTo(p[0], p[1], p[2], p[3], p[4], p[5])
+            PathIterator.SEG_CLOSE -> path.closePath()
+        }
+        iterator.next()
+    }
+    path.detach()
+}
+
+private const val MAX_OUTLINE_CACHE_ENTRIES = 512
