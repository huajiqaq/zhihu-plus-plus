+/** Hidden prose keeps its authored links and ranges, but only the reveal action can run. */
+private fun ResolvedMarkdownText.withHiddenSpoilers(text: MarkdownText): ResolvedMarkdownText {
+    if (hiddenSpoilers.isEmpty()) return this
+    require(text.spans.all { it.range.endExclusive <= text.value.length }) { "Node range exceeds MarkdownText.value" }
+    val links = annotated.getLinkAnnotations(0, annotated.length)
+    val withoutLinks = annotated.flatMapAnnotations { range ->
+        if (range.item is LinkAnnotation) emptyList() else listOf(range)
+    }
+    val builder = AnnotatedString.Builder(withoutLinks)
+    val edges = hiddenSpoilers.flatMap { listOf(it.start, it.endExclusive) }.distinct().sorted()
+    edges.zipWithNext().forEach { (start, end) ->
+        val spoiler = hiddenSpoilers.filter { it.start <= start && it.endExclusive >= end }
+            .maxByOrNull { it.sourceRange.endExclusive - it.sourceRange.start } ?: return@forEach
+        builder.addLink(LinkAnnotation.Clickable("markdown-spoiler-$start", styles = TextLinkStyles(),
+            linkInteractionListener = { spoiler.onReveal() }), start, end)
+        builder.addCjkInteractionOnlyAnnotation(start, end)
+    }
+    // Preserve URL/footnote classification and styling at the original ranges.
+    links.forEach { link ->
+        when (val annotation = link.item) {
+            is LinkAnnotation.Url -> builder.addLink(annotation, link.start, link.end)
+            is LinkAnnotation.Clickable -> builder.addLink(annotation, link.start, link.end)
         }
     }
+    hiddenSpoilers.forEach { spoiler ->
+        val mask = SpanStyle(color = spoiler.color)
+        builder.addStyle(mask, spoiler.start, spoiler.endExclusive)
+        builder.addLink(LinkAnnotation.Clickable("markdown-spoiler-mask-${spoiler.spanIndex}",
+            styles = TextLinkStyles(style = mask), linkInteractionListener = { spoiler.onReveal() }), spoiler.start, spoiler.endExclusive)
+        builder.addCjkInteractionOnlyAnnotation(spoiler.start, spoiler.endExclusive)
+    }
+    val source = text.value.toCharArray()
+    hiddenSpoilers.forEach { spoiler ->
+        for (offset in spoiler.sourceRange.start until spoiler.sourceRange.endExclusive) source[offset] = ' '
+    }
+    val outerSpoilers = hiddenSpoilers.filter { spoiler ->
+        hiddenSpoilers.none { outer -> outer !== spoiler && outer.start <= spoiler.start && outer.endExclusive >= spoiler.endExclusive &&
+            (outer.start < spoiler.start || outer.endExclusive > spoiler.endExclusive || outer.spanIndex < spoiler.spanIndex) }
+    }
+    return copy(
+        annotated = builder.toAnnotatedString(),
+        semanticsText = AnnotatedString(source.concatToString()),
+        interactions = interactions.filter { action ->
+            hiddenSpoilers.none { action.start < it.endExclusive && action.endExclusive > it.start }
+        } + outerSpoilers.map { spoiler ->
+            ResolvedInlineInteraction(spoiler.start, spoiler.endExclusive, "显示隐藏内容", spoiler.onReveal)
+        },
+        tiqianInlineObjects = tiqianInlineObjects.map { inline ->
+            val spoiler = hiddenSpoilers.filter { it.start <= inline.start && it.endExclusive >= inline.endExclusive }
+                .maxByOrNull { it.sourceRange.endExclusive - it.sourceRange.start }
+            if (spoiler == null) inline else inline.copy(content = inline.content.copy(onClick = spoiler.onReveal))
+        },
+    )
 }
