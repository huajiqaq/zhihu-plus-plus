+            metadata = metadata(0),
+        )
+        val article = MarkdownRenderDocument(listOf(table))
+        val body = TextStyle(color = Color.Black, fontFamily = FontFamily.Serif, fontSize = 18.sp, lineHeight = 28.sp)
+        val style = MarkdownStyle(body = body, tableText = body, highlight = SpanStyle(color = Color.Blue, background = Color.Green))
+        lateinit var scope: CoroutineScope
+        ImageComposeScene(width = 320, height = 240, coroutineContext = coroutineContext) {
+            scope = rememberCoroutineScope()
