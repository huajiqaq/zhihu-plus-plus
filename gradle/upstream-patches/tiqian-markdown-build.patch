+            suspend fun advance() {
+                Snapshot.sendApplyNotifications()
+                scene.render(frame).close()
+                frame += 16_000_000L
+                yield()
+            }
+            repeat(4) { advance() }
+            assertEquals(0, countPixels(scene) { it == Color.Green }, "The marked last cell must start offscreen")
+            val before = scroll.value
+            val revealing = scope.async { state.reveal(state.matches.single()) }
+            repeat(180) { if (!revealing.isCompleted) advance() }
+            assertTrue(revealing.isCompleted && revealing.await())
+            advance()
+            assertEquals(before, scroll.value, "Only the horizontal axis needed scrolling")
+            // Half-red over solid green is olive. Neither layer alone, nor a fringe on white, is olive.
+            val highlighted = countPixels(scene) {
+                it.red in 0.48f..0.52f && it.green in 0.48f..0.52f && it.blue < 0.02f
+            }
+            assertTrue(highlighted > 20, "Search must paint inside the original mark")
+            assertTrue(countPixels(scene) { it == Color.Blue } > 0, "Search must leave the marked glyph ink on top")
+            assertEquals(0, countPixels(scene) { it.red in 0.48f..0.52f && it.green < 0.02f && it.blue < 0.02f },
+                "Search must not tint the black mask and expose the concealed glyphs")
