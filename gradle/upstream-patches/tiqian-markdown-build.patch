+    val markers = ordered.map { marker ->
+        output.append(annotated.text.substring(cursor, marker.endExclusive))
+        val start = output.length
+        output.append('￼')
+        output.addCjkRenderOnlyInlineObject(start, start + 1)
+        cursor = marker.endExclusive
+        marker.copy(endExclusive = start + 1)
+    }
+    output.append(annotated.text.substring(cursor))
+    val annotations = mutableListOf<AnnotatedString.Range<AnnotatedString.Annotation>>()
+    // Map whole authored annotations once; slicing would split links and TTS at each marker.
+    annotated.flatMapAnnotations { annotation ->
+        val start = map(annotation.start, true)
+        val end = if (annotation.start == annotation.end) start else map(annotation.end, false)
+        annotations += AnnotatedString.Range(annotation.item, start, end, annotation.tag)
+        emptyList()
+    }
+    val projected = output.toAnnotatedString()
+    projected.flatMapAnnotations { annotation ->
+        annotations += AnnotatedString.Range(annotation.item, annotation.start, annotation.end, annotation.tag)
+        emptyList()
+    }
+    return copy(
+        annotated = AnnotatedString(projected.text, annotations),
+        tiqianInlineObjects = tiqianInlineObjects.map { it.copy(start = map(it.start, true), endExclusive = map(it.endExclusive, false)) },
+        backgrounds = backgrounds.map { it.copy(start = map(it.start, true), endExclusive = map(it.endExclusive, false)) },
+        decorations = decorations.map { it.copy(start = map(it.start, true), endExclusive = map(it.endExclusive, false)) },
+        interactions = interactions.map { it.copy(start = map(it.start, true), endExclusive = map(it.endExclusive, false)) },
+        hiddenSpoilers = hiddenSpoilers.map { it.copy(start = map(it.start, true), endExclusive = map(it.endExclusive, false)) },
+        sourceToRenderedOffset = { offset, end -> map(sourceToBaseOffset(offset, end), after = !end) },
