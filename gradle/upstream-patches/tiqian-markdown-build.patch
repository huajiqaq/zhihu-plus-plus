+    private inline fun countPixels(scene: ImageComposeScene, matches: (Color) -> Boolean): Int {
+        val pixels = scene.render().use { it.toComposeImageBitmap().toPixelMap() }
+        var count = 0
+        for (y in 0 until pixels.height) for (x in 0 until pixels.width) {
+            if (matches(pixels[x, y])) count++
+        }
+        return count
